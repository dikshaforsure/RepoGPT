# Copy this file to .env and add your own values.
# Never commit .env or share these keys.

GROQ_API_KEY=
GITHUB_TOKEN=

# Optional: must be a model currently available to your Groq account.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: downloaded and run locally on first use.
EMBED_MODEL=BAAI/bge-small-en-v1.5
